# Postgres (Supabase, EU region — data residency requirement)
DATABASE_URL="postgresql://user:password@host:5432/spokkio?schema=public"

# Auth
JWT_SECRET="change-me-in-production"

# WhatsApp Cloud API (direct Meta integration, no BSP)
WHATSAPP_WEBHOOK_VERIFY_TOKEN="change-me"
# Per-connection access token/phoneNumberId are stored per-team in
# WhatsAppConnection, not here — these globals are only for local dev seeding.

# Transparent per-conversation markup shown as its own cost-simulator line
PLATFORM_MARKUP_PER_CONVERSATION_EUR="0.01"

# URL pubblico raggiungibile da chi riceve i messaggi (in locale, il tunnel
# ngrok già usato per il webhook Meta): serve ai link tracciati nelle
# campagne per reindirizzare correttamente e registrare i click reali.
PUBLIC_BASE_URL="http://localhost:3001"

PORT=3001
